{
  "name": "yagent",
  "version": "0.1.0",
  "description": "A mini agentic system — OpenClaw in miniature (COSCUP 2026 demo)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:cli": "tsx src/index.ts --cli",
    "dev:web": "tsx watch src/index.ts --web",
    "dev:all": "concurrently -k -n backend,web -c blue,green \"npm run dev:web\" \"npm run web:dev\"",
    "build": "tsc",
    "start": "node dist/index.js --web",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "e2b": "^1.13.2",
    "openai": "^4.78.0",
    "playwright": "^1.49.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.12",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
