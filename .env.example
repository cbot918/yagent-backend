OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: route the CHAT model through OpenRouter (or any OpenAI-compatible API).
# NOTE: this only affects chat completions. It does NOT serve audio transcription —
# voice uses the separate VOICE_* settings below.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
DISCORD_TOKEN=
WORKSPACE_DIR=./workspace

# Web UI (workflow monitor) — also enable with the --web flag
# ENABLE_WEB=false
# WEB_PORT=3001
# On a PaaS (Zeabur/Railway/etc) the injected PORT env takes precedence over WEB_PORT.
# When the frontend is deployed as a SEPARATE service, set its URL here so the API
# allows cross-origin requests (CORS). '*' is fine for local/demo.
# WEB_ORIGIN=https://yagent-webui.zeabur.app

# --- Shell tool ---
# Master switch for the shell tool. Keep false unless you want command execution.
ALLOW_SHELL=false

# Where shell commands run:
#   host   = on this machine, NO sandbox (dev only)
#   docker = hardened per-session container (needs Docker installed)
#   e2b    = managed Firecracker microVM (works without Docker; needs E2B_API_KEY)
SHELL_BACKEND=host
SHELL_TIMEOUT_MS=15000

# docker backend options
SANDBOX_IMAGE=node:22-alpine
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
# Network for the sandbox: 'none' blocks outbound (safest; curl will fail).
# Set to 'bridge' to allow outbound network — note the SSRF/exfiltration tradeoff.
SANDBOX_NETWORK=none

# e2b backend (https://e2b.dev) — required when SHELL_BACKEND=e2b
E2B_API_KEY=

# --- Browser tool (local headless Playwright) ---
# Lets the agent open web pages and read their text (e.g. fetch news headlines).
# One-time setup: npx playwright install chromium
# Runs on the host; a built-in SSRF guard blocks localhost/private/metadata URLs.
ALLOW_BROWSER=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000

# --- Voice input (web UI mic) ---
# The browser uses the free Web Speech API when available (Chrome/Edge/Safari).
# For browsers without it (e.g. Firefox), it falls back to server transcription
# via this OpenAI-compatible endpoint — kept SEPARATE from OPENAI_BASE_URL because
# OpenRouter does not implement /audio/transcriptions. Leave VOICE_API_KEY empty
# to disable the fallback (Web Speech still works).
VOICE_API_URL=https://api.openai.com/v1
VOICE_API_KEY=
VOICE_MODEL=whisper-1
