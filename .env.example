OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=minimax/minimax-m2.5
DISCORD_TOKEN=
# Optional: use OpenRouter (or any OpenAI-compatible API)
# OPENAI_API_KEY=sk-or-...
WORKSPACE_DIR=./workspace
# 第二個受守衛的根目錄，唯讀，涵蓋這台機器上的其他 repo。
# 刻意不直接把 WORKSPACE_DIR 指高一層——那會連 write_file/shell 的可寫範圍一起放大，
# 而且 .sessions/.memory 就住在 WORKSPACE_DIR 底下，一改就找不到既有 session。
# 空 = list_project_files / read_project_file 不註冊。
PROJECTS_ROOT=
ALLOW_SHELL=false

# Flow-Bot
ENSEMBLEDATA_TOKEN=
# 開啟 headless 瀏覽器（threads_trend 的 browser 來源與 browse 工具需要）
ALLOW_BROWSER=true

# eai-erp 報價 ERP 後端。設了 EAIERP_BASE_URL 才會註冊 list_quote_catalog / create_quote_from_spec。
# 機器認證用 shared secret，送到後端的 X-Service-Token（＝後端的 SERVICE_TOKEN）。
EAIERP_BASE_URL=
EAIERP_SERVICE_TOKEN=

# 軟體專案（swpm）工具的第二組 token（＝後端的 SWPM_SERVICE_TOKEN）。
# 刻意與報價的分開：後端把它對應到 AGENT_SWPM 角色，只有 swpm.read/write，
# 所以任一組外洩都碰不到另一個模組。沒設 = 七個 swpm 工具不註冊。
EAIERP_SWPM_TOKEN=

# 待辦／成果清單工具的第三組 token（＝後端的 TODO_SERVICE_TOKEN）。
# 對應後端 AGENT_TODO 角色，只有 todo.read/write。沒設 = 七個待辦工具不註冊
# （list_todos / get_todo / refine_todo / create_todo / set_todo_status /
#  create_outcome / list_outcomes）。工作流見 workflow/workflow-todolist.md。
EAIERP_TODO_TOKEN=

# smoke_check（SA 的 E2E 驗收工具）可以打的 origin 白名單，逗號分隔。
# 與 browse 的黑名單相反：這裡沒列到的一律打不到，包含 localhost。空 = 工具不註冊。
E2E_ALLOWED_ORIGINS=
E2E_TIMEOUT_MS=15000

# Codex CLI（QA 角色的 coding harness，與 engineer 的 Claude 分帳）。
# CODEX_JSON=true 才會走 JSONL 並拿得到 token 數；預設純文字模式相容任何版本。
CODEX_BIN=codex
CODEX_MODEL=
# read-only | workspace-write | danger-full-access
CODEX_SANDBOX=workspace-write
# codex 不在 git repo 裡會拒跑。預設保持 false，讓「派錯目錄」大聲失敗而不是默默動手。
CODEX_SKIP_GIT_CHECK=false
CODEX_JSON=false